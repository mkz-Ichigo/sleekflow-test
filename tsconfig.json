{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@utils/*": [
        "./core/utils/*"
      ],
      "@testdata/*": [
        "./data/*"
      ],
      "@pages/*": [
        "./pages/*"
      ],
      "@fixtures/*": [
        "./core/fixtures/*"
      ],
      "@basepages/*": [
        "./core/pages/*"
      ],
      "@config/*": [
        "./core/config/*"
      ]
    },
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "tests/**/*.ts",
    "pages/**/*.ts",
    "core/**/*.ts",
    "data/**/*.json",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}